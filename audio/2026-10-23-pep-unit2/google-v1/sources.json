    "sha256": "594e41e3f58cf290ec99ffe36e1c08fee6813bc9193f7beaa291a186b1f2a944"
  },
  {
    "file": "sentence-11.mp3",
    "text": "Mum! Dad! This is my friend, Sarah Miller.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Mum%21%20Dad%21%20This%20is%20my%20friend%2C%20Sarah%20Miller.&tl=en&client=tw-ob&ttsspeed=1",
