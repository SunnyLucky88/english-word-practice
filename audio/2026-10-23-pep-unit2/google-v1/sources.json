  },
  {
    "file": "sentence-12.mp3",
    "text": "Hi, Sarah.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Hi%2C%20Sarah.&tl=en&client=tw-ob&ttsspeed=1",
