  },
  {
    "file": "sentence-08.mp3",
    "text": "Is that your brother?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Is%20that%20your%20brother%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "5e90aeb99633265b49a978ad2d29d2cd046ae3afbaf257c7750ffdd0c498fcfc"
  },
  {
    "file": "sentence-09.mp3",
    "text": "Yes, it is.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes%2C%20it%20is.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "ed13e56bdcad30029e6cecb646f410a11f2b633663b1c3fc61e291ec0756b551"
  },
  {
    "file": "sentence-10.mp3",
    "text": "My family is big.",
