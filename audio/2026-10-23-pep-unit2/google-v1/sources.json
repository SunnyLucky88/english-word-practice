  },
  {
    "file": "sentence-04.mp3",
    "text": "This is my family.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=This%20is%20my%20family.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "fae6491a5cd27babf8cd623196802f043549207da1180f67ef5a123da3659379"
  },
  {
    "file": "sentence-05.mp3",
    "text": "You have a big family.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=You%20have%20a%20big%20family.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "d50e3aa14a32093a41906c2ace0194bb20b63a33ebd5bb9a7b59bd1699e0b788"
  },
  {
    "file": "sentence-06.mp3",
    "text": "Is this your sister?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Is%20this%20your%20sister%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "b2d6987f815224f935359e310fd5bec323ad37c93acc42487ae5c479a80e02e0"
  },
  {
    "file": "sentence-07.mp3",
    "text": "No, it's my cousin.",
