  },
  {
    "file": "sentence-88.mp3",
    "text": "Yes. We're big.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes.+We%27re+big.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "3efbcedad8068e7f268c192020ec082364c889ecb5b9af4b049fe792858dce24"
