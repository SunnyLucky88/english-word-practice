  {
    "file": "sentence-01.mp3",
    "text": "Whose hands are these?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Whose+hands+are+these%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "64a56a57dcb2a9ef2effdf61b71b6d3857fde445bafe243ad59b698431ebfd5d"
  },
  {
    "file": "sentence-02.mp3",
    "text": "What animals do you know?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=What+animals+do+you+know%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "60918db12b0c56483545dce0d5534e5a944387b7ae5214a65136c8ab5f5cd3fd"
  },
  {
    "file": "sentence-03.mp3",
    "text": "So many animals,",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=So+many+animals%2C&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "7aff8049c78babc01c48825bbc15556e6dd8f243a2b9e71f1a602504a648cabb"
  },
  {
    "file": "sentence-04.mp3",
    "text": "Big, tall and small.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Big%2C+tall+and+small.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "1d2786ccc43ede454ed08d8a9d460ed39628a47e0cb42d80cf6dc7b014405057"
  },
  {
    "file": "sentence-05.mp3",
    "text": "Pets and wild animals,",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Pets+and+wild+animals%2C&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "50029980d057d5968c70930e3eb4112b97e6bb2322695864f415983d6fe4b0af"
  },
  {
    "file": "sentence-06.mp3",
    "text": "We love them all.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=We+love+them+all.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "3090a2d00adabf1d6b16844143d88b08f2ffbdf2175b7976a521106b42314cb1"
  },
  {
    "file": "sentence-07.mp3",
    "text": "Animal song",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Animal+song&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "1ca1451f00c4ab5996ffd00530fe139a789fe9ab0e1685eadc565d1163e5e66c"
  },
  {
    "file": "sentence-08.mp3",
    "text": "Good morning, Mike!",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Good+morning%2C+Mike%21&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "37dbba232fc110029755f7062337347d672751a9d41b9019d278cbc610c152df"
  },
  {
    "file": "sentence-09.mp3",
    "text": "Good morning! Come in.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Good+morning%21+Come+in.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "787db4bba3f468e748ffc9aa239da222431e699e558c6ec313f58763d0fd6794"
  },
  {
    "file": "sentence-10.mp3",
    "text": "I like your dog.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+like+your+dog.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "02f9c196789c2ea48694755d9dbbe930407379ebd6c4b113ec190db02900e4ed"
  },
  {
    "file": "sentence-11.mp3",
    "text": "Thanks. Do you have a pet?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Thanks.+Do+you+have+a+pet%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "13b9c650a52ca0c6a4ea1befba962a84ff78706ddaaca82d1fa8ede3c511fb25"
  },
  {
    "file": "sentence-12.mp3",
    "text": "No, I don't.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=No%2C+I+don%27t.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "fe473dba738deb4466000379a9dcb51c2df92ca6001e09e1e7551915b6977515"
  },
  {
    "file": "sentence-13.mp3",
    "text": "Yes, I do. I have a cat.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes%2C+I+do.+I+have+a+cat.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "b3b38970b2b177e9b04e04080ce238b87a8d5e379c899b6c05625a95a3e451d7"
  },
  {
    "file": "sentence-14.mp3",
    "text": "Do you have a pet?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Do+you+have+a+pet%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "b475573a64b7dc317115abf108dc26242fffc87dd6034fcee75cf3d148057307"
  },
  {
    "file": "sentence-15.mp3",
    "text": "Yes, I do. I have a dog.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes%2C+I+do.+I+have+a+dog.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "80272c3d11f54c4bcdb4d63753b2c6c8a2d36349f59ed7098c59a046bdd468a1"
  },
  {
    "file": "sentence-16.mp3",
    "text": "I like fish.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+like+fish.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "3803ed9c40001b02dc8bd449fdf21db71ed8a85d026ad3a90e0680c8df337a7e"
  },
  {
    "file": "sentence-17.mp3",
    "text": "I like cats.",
