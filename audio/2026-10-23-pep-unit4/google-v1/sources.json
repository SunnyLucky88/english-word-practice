  {
    "file": "sentence-01.mp3",
    "text": "What plants do you see?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=What+plants+do+you+see%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "9f4eb4417a80e84663a5646e48f5c74b3e0e78edcbd0e89b4b664b9da99e578f"
  },
  {
    "file": "sentence-02.mp3",
    "text": "What fruit do you like?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=What+fruit+do+you+like%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "c144d5660fc3878fa472548d0121b273dbde18a908e5b8478c8d5acc43fbd8ce"
  },
  {
    "file": "sentence-03.mp3",
    "text": "I see an apple.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+see+an+apple.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "d5540b270b568788cf56696c688ebd1b8995417f79bdb83533aeb8d580d1b73e"
  },
  {
    "file": "sentence-04.mp3",
    "text": "I see grapes.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+see+grapes.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "6c293fa1a9b2e0302f9cff3d231544598155e9df6d94ad1c9b04bbc5152960e3"
  },
  {
    "file": "sentence-05.mp3",
    "text": "I like fruit.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+like+fruit.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "a4c2775cc0603c31036c199f2edae2abe471d03fb80047ee691108289552041f"
  },
  {
    "file": "sentence-06.mp3",
    "text": "Let's eat!",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Let%27s+eat%21&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "d6c2d297daedaf59f57fb2e3766b057ef39c01ba458b7cee8f5479c836910af7"
  },
  {
    "file": "sentence-07.mp3",
    "text": "I have a garden.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+have+a+garden.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "1ecd331b4b1e02e367e4815e2580629df6db8737f6aebc31381ca6b858da145f"
  },
  {
    "file": "sentence-08.mp3",
    "text": "I have water.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+have+water.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "c3a01ed875d29d837fdd88ab2f5d4c5c47a7d9835169c88f14729caa039e7a63"
  },
  {
    "file": "sentence-09.mp3",
    "text": "I like apples.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+like+apples.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "05dc2c12815b1583e4a2e1269853979f1a302ee025cd36b4bb49adcace6cbe39"
  },
  {
    "file": "sentence-10.mp3",
    "text": "Let's grow a tree!",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Let%27s+grow+a+tree%21&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "33bc93b2a5ca124ca090763bae3ced921db3bc203e93839dfcbd9d727425b4c4"
  },
  {
    "file": "sentence-11.mp3",
    "text": "Plants and us",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Plants+and+us&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "273354bf3411f6d2f3f1899baa97a3c30608624383c19174b6ce832c3ffb8270"
  },
  {
    "file": "sentence-12.mp3",
    "text": "Mike, do you like apples?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Mike%2C+do+you+like+apples%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "fa2c694eef395105ad776f279e42cbf95c84b52d47e37b76476577aea060f401"
  },
  {
    "file": "sentence-13.mp3",
    "text": "Yes, I do. And you?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes%2C+I+do.+And+you%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "b9355db0f1f093a24212f9c50fc9a3bf252d9fc76ec3de783698f05fab7f3e1f"
  },
  {
    "file": "sentence-14.mp3",
    "text": "No, I don't. I like bananas.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=No%2C+I+don%27t.+I+like+bananas.&tl=en&client=tw-ob&ttsspeed=1",
