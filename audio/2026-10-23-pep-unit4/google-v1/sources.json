  },
  {
    "file": "sentence-15.mp3",
    "text": "Do you like the farm?",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Do+you+like+the+farm%3F&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "685e8bd1722495d771c505dd64298b5c6ba108e8a5a7631a1a8bfa0b68cc9538"
  },
  {
    "file": "sentence-16.mp3",
    "text": "Yes, Miss White.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Yes%2C+Miss+White.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "6db1542b9e5e476d4d8b9110c34ccfafc3bffb48bbc174b0643c9384f0202647"
  },
  {
    "file": "sentence-17.mp3",
    "text": "I like fresh air.",
