  },
  {
    "file": "key-08.mp3",
    "text": "Thanks, Sarah.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Thanks%2C+Sarah.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "ffa846e606b024c17119df9d48ceda9b45716a06157e27a89a7630273cf136df"
  },
  {
    "file": "key-09.mp3",
    "text": "Thank you, Chen Jie.",
