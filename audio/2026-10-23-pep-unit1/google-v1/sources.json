  {
    "file": "key-05.mp3",
    "text": "Oh no!",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Oh+no%21&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "d7653027dac7721a9240a0f79fc2769279cfd1c1366c27a0e1ad4554daaf9293"
  },
  {
    "file": "key-06.mp3",
    "text": "It's OK, Chen Jie.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=It%27s+OK%2C+Chen+Jie.&tl=en&client=tw-ob&ttsspeed=1",
