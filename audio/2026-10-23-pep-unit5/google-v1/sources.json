    "sha256": "dc5399baa4abd1ff0f4b0fb778166fa1b8fcdfa514427f02d9e0b40fa14b6e64"
  },
  {
    "file": "key-03.mp3",
    "text": "Red and blue make purple.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Red+and+blue+make+purple.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "821d603279857aeb661adcf4920047f96db3a1ab29165e78dde269801def2eb2"
  },
  {
    "file": "key-07.mp3",
    "text": "Use again!",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Use+again%21&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "71bfbb124a98e76979eb51f32f9eac5a2b2187e1043627b05286656b298d9763"
  },
  {
    "file": "key-08.mp3",
