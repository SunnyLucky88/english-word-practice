    "sha256": "78224fb4a5a7127603b65cacbc0651456d2ced8f44f608b7f63b17f95e2d00e7"
  },
  {
    "file": "sentence-84.mp3",
    "text": "Colours are beautiful.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=Colours+are+beautiful.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "f54814078976860963474470ae7221bd83d189cc71bfc10b025b8cffe69b4e2d"
  },
  {
    "file": "sentence-85.mp3",
    "text": "Colours help us and tell us many things.",
