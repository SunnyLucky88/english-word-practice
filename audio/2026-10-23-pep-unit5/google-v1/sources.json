    "sha256": "927854b7a69338a5246b9ebf5e6a048a1a5763a9b558d3d1f5f9eaf399fa0eab"
  },
  {
    "file": "sentence-80.mp3",
    "text": "I give them food.",
    "source": "https://translate.google.com/translate_tts?ie=UTF-8&q=I+give+them+food.&tl=en&client=tw-ob&ttsspeed=1",
    "sha256": "9b045739f539f714caa393d6828fc440967f5eaac593b9db388599fc273459f1"
  },
  {
    "file": "sentence-81.mp3",
    "text": "Now it is cold. I am green and brown.",
